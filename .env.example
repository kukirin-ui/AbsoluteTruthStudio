# Absolute Truth Studio — environment variables.
# Copy this file's variable NAMES into Vercel → Settings → Environment Variables
# (Production). Never commit real values — this file holds only placeholders.

# ── Database (required) ─────────────────────────────────────────────────────
# Neon (or any Postgres) connection string. Without this, auth/BYOK/billing
# fall back to an in-memory dev store that resets on every cold start.
DATABASE_URL=

# ── Auth (required for real sign-in) ────────────────────────────────────────
VITE_AUTH_ENABLED=true
# Must be the exact production URL — without it, Better Auth only trusts
# localhost/preview hosts and rejects your real domain as "Invalid origin".
BETTER_AUTH_URL=https://your-domain.example.com
# Long random string (e.g. `openssl rand -hex 32`). Without it, sessions get
# invalidated randomly as serverless instances cold-start with a new secret.
BETTER_AUTH_SECRET=
# Code that unlocks the owner/premium account. Defaults to ATS-OWNER if unset
# — set a real value before going live.
OWNER_CODE=
# Encrypts BYOK credentials at rest. Generate once, never rotate casually
# (rotating invalidates every stored BYOK key).
BYOK_ENCRYPTION_KEY=

# ── Mesh LLM providers — owner keys (studio/credit-funded runs) ─────────────
# Only set the ones you want funding studio credits. Users can also bring
# their own key per provider (BYOK) regardless of which of these are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Alibaba DashScope (Qwen). QWEN_API_KEY works as an alias if you prefer the name.
DASHSCOPE_API_KEY=
# Muse Spark — Meta's own current model (successor to Llama; Meta retired its
# old first-party Llama API in July 2026). Sources differ slightly on the
# official variable name, so the app checks both.
META_API_KEY=
MODEL_API_KEY=

# ── Mesh model pins (optional) ──────────────────────────────────────────────
# Override the exact model id per provider without a code deploy. Leave unset
# to use the current flagship default baked into src/lib/providers.ts.
# MESH_MODEL_ANTHROPIC=
# MESH_MODEL_OPENAI=
# MESH_MODEL_GOOGLE=
# MESH_MODEL_XAI=
# MESH_MODEL_MISTRAL=
# MESH_MODEL_DEEPSEEK=
# MESH_MODEL_QWEN=
# MESH_MODEL_META=

# ── Video/image agent aggregators (optional — only if those seats are live) ─
FAL_API_KEY=
AIMLAPI_API_KEY=
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ── Billing ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Legacy / only relevant if still brokering sign-in through Grok's platform ─
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=
